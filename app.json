{
  "expo": {
    "name": "BioShelf",
    "slug": "bioshelf",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bioshelf",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0D11",
    "ios": {
      "bundleIdentifier": "edu.rvu.bioshelf",
      "supportsTablet": true
    },
    "android": {
      "package": "edu.rvu.bioshelf",
      "adaptiveIcon": {
        "backgroundColor": "#0B0D11",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "BioShelf",
      "shortName": "BioShelf",
      "themeColor": "#0B0D11",
      "backgroundColor": "#0B0D11",
      "description": "Track healthcare assets, expiry dates, cold-chain stock and equipment service."
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0D11",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "BioShelf uses your photos so you can attach a picture of a product label to an asset.",
          "cameraPermission": "BioShelf uses the camera to photograph product labels and read their details automatically."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
